{
  "name": "deepsec-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered vulnerability scanner for any codebase",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/deepsec.git"
  },
  "scripts": {
    "build": "pnpm -r --filter '!website' build",
    "bundle": "pnpm --filter @aryasaatvik/deepsec bundle",
    "deepsec": "tsx packages/deepsec/src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project scanner --project processor --project cli",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:live": "LIVE_AGENT=1 vitest run --project e2e",
    "test:bundle": "pnpm bundle && vitest run --project e2e e2e/bundle.test.ts",
    "typecheck:deepsec": "pnpm -C .deepsec install --frozen-lockfile --silent && tsc -p .deepsec",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "validate": "pnpm -r --filter '!website' build && pnpm lint && pnpm knip && pnpm bundle && pnpm typecheck:deepsec && pnpm test"
  },
  "keywords": [
    "security",
    "vulnerability",
    "scanner",
    "claude",
    "ai",
    "static-analysis"
  ],
  "author": "Saatvik Arya",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^22.0.0",
    "knip": "^6.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aryasaatvik/deepsec": "workspace:*"
  }
}
